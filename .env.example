# Frontend and backend local development settings
REACT_APP_GOOGLE_OAUTH_URL=
REACT_APP_ADMIN_EMAILS=
REACT_APP_APPROVAL_EMAIL_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
REACT_APP_NEWSLETTER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
REACT_APP_DARBAR_SAHIB_STREAM_URL=/api/streaming/darbar-sahib/live
REACT_APP_DONATION_PUBLIC_URL=http://localhost:3001
REACT_APP_SIKHNET_GURPURAB_CALENDAR_URL=https://sikhnet.com/pages/sikh-gurpurab-calendar
# Gurpurab API reference: https://api.gurpurab.com/
# Base URL used for yearly holidays (?year=...) and upcoming holidays (/upcoming?limit=...).
REACT_APP_GURPURAB_HOLIDAYS_API_URL=https://api.gurpurab.com/v1/holidays

# Volunteer reminder scheduler (daily send time in 24h format)
VOLUNTEER_REMINDER_SEND_TIME=09:00
VOLUNTEER_REMINDER_TIME_ZONE=America/Toronto
VOLUNTEER_REMINDER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
EVENT_REMINDER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
DONATION_INVOICE_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay

# Local relay sender and optional explicit relay URL override.
LOCAL_MAIL_FROM=no-reply@singhsabhamilton.com
INTERNAL_MAIL_RELAY_URL=http://127.0.0.1:4242/api/internal/mail-relay

# Mail transport mode:
# - sendmail (default): uses local /usr/sbin/sendmail
# - smtp: uses SMTP provider via nodemailer
LOCAL_MAIL_TRANSPORT=sendmail

# SMTP settings (required only when LOCAL_MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

HOST=0.0.0.0
PORT=3001
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# Zeffy donation form webhook (server-only; never use REACT_APP_ for secrets)
ZEFFY_API_KEY=
ZEFFY_WEBHOOK_TOKEN=
ZEFFY_CAMPAIGN_ID=
ZEFFY_CAMPAIGN_NAME=Help Us Build Our Gurdwara

# YouTube
YOUTUBE_API_KEY=

# PostgreSQL database (required to persist events across devices)
# Example (Neon/Supabase/Railway/Render managed Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Optional discrete DB fields (use only if DATABASE_URL is not provided)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
