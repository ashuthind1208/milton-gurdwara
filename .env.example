# Frontend and backend local development settings
REACT_APP_GOOGLE_OAUTH_URL=
REACT_APP_ADMIN_EMAILS=
REACT_APP_APPROVAL_EMAIL_WEBHOOK_URL=
REACT_APP_DARBAR_SAHIB_STREAM_URL=https://live.sgpc.net:8442/

HOST=0.0.0.0
PORT=3001
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# YouTube
YOUTUBE_API_KEY=

# PostgreSQL database (required to persist events across devices)
# Example (Neon/Supabase/Railway/Render managed Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Optional discrete DB fields (use only if DATABASE_URL is not provided)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
